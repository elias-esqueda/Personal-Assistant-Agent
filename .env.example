# Plantilla de variables. Copia a .env y rellena. EL .env NO SE SUBE A GIT.
# ---------------------------------------------------------------------------

# === n8n API (la usa el MCP de Claude Code para auditar/editar workflows) ===
# Regenerar en: n8n → Settings → n8n API.
# OJO: la clave que existía en jun-2026 expira 2026-09-20.
N8N_API_URL=https://TU-INSTANCIA-n8n
N8N_API_KEY=

# === Stack n8n (docker-compose) ===
# CRÍTICO: N8N_ENCRYPTION_KEY descifra las credenciales guardadas en n8n.
#   - Si quieres REUSAR credenciales de un backup, pon aquí la llave ORIGINAL
#     (guárdala fuera de git). Si la cambias, las credenciales viejas dejan de servir.
#   - Si vas a recrear credenciales a mano, puedes generar una nueva:
#       openssl rand -hex 16
N8N_ENCRYPTION_KEY=
N8N_HOST=tu-dominio.example.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://tu-dominio.example.com/

# === Postgres (DB de n8n + memoria de chat del agente) ===
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=n8n-db
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=
POSTGRES_PASSWORD=

# === Ollama (modelo del AI Agent) ===
# El nodo usa el modelo gemma4:31b. La URL del servidor Ollama va en la
# credencial "Ollama account" dentro de n8n, no aquí. Apunta a donde corra Ollama.
OLLAMA_BASE_URL=http://tu-host-ollama:11434
